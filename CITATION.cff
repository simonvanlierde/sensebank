# GitHub reads this for its "Cite this repository" button. Zenodo reads
# .zenodo.json instead when it archives a release, and software indexes read
# codemeta.json. Edit this file only, then run `just citation` to write the other
# two from it; a git hook fails while they disagree. Check the name split below:
# the first word becomes the given name.
cff-version: 1.2.0
message: If you use this software, please cite it as below.
title: "sensebank"
abstract: "Multilingual word lists with concept context and group rules"
authors:
  - given-names: "Simon"
    family-names: "van Lierde"
    orcid: "https://orcid.org/0009-0006-6953-909X"
    email: "code@duinlab.nl"
repository-code: "https://github.com/simonvanlierde/sensebank"
license: MIT
